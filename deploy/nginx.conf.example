# 放到 /etc/nginx/sites-available/acc-core 后启用。
# 工作台只反代到本机 3780；HTTPS 终止在 Nginx。

upstream acc_core {
    server 127.0.0.1:3780;
    keepalive 8;
}

server {
    listen 80;
    server_name workbench.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name workbench.example.com;

    ssl_certificate     /etc/ssl/certs/workbench.example.com.crt;
    ssl_certificate_key /etc/ssl/private/workbench.example.com.key;

    client_max_body_size 1m;

    location / {
        proxy_pass http://acc_core;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
    }
}
