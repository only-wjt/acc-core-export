# 复制为 deploy/.env 后填写。Docker 会覆盖 HOST / PORT / PERSIST_DIR / CHROME_PATH，这几项按容器内路径生效。

HOST=0.0.0.0
PORT=3780
HOST_PORT=3780

WORKBENCH_ADMIN_USER=admin
WORKBENCH_PASSWORD=换成足够长的口令
ALLOWED_HOSTS=workbench.example.com,服务器公网IP
SECURE_COOKIE=0

PERSIST_DIR=/data
CHROME_PATH=/usr/bin/google-chrome-stable

# 生产建议先压并发，避免 mail.com / OpenAI 风控
MAX_CONCURRENCY=8
PW_CF_MAX=4
MAIL_LOGIN_CONCURRENCY=2
MAIL_LOGIN_GAP_MS=1500

# 发版回滚用，日常保持 latest
IMAGE_TAG=latest

# 开放 API。给 CDK 用时填写；也可用工作台「开放 API」页各自创建密钥
OPENAPI_KEY=
OPENAPI_CORS=*
OPENAPI_MAX_KEYS=3
OPENAPI_RATE_LIMIT=60
